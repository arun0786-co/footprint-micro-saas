# copy to .env or set these on your host
APP_SECRET=put-a-long-random-string-here
# email: resend.com (easy) or your own smtp
RESEND_KEY=
MAIL_FROM=footprint <noreply@yourdomain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# optional, paid key from haveibeenpwned.com. without it we use xposedornot (free, low volume)
HIBP_KEY=
# payment link for the pro plan
PAY_LINK=
PRO_PRICE=₹99 / month
# DEV=1 shows the login code on the page when no email is set up (local only!)
DEV=
